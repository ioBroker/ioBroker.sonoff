{
    "type": "panel",
    "i18n": true,
    "items": {
        "_header1": {
            "type": "header",
            "text": "Connection settings",
            "size": 3,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "_headerExternal": {
            "newLine": true,
            "type": "header",
            "text": "External MQTT broker",
            "size": 3,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "useExternalBroker": {
            "newLine": true,
            "type": "checkbox",
            "label": "Use external MQTT broker",
            "help": "Disables the built-in MQTT server and connects as client to an external broker",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "externalBrokerUrl": {
            "newLine": true,
            "type": "text",
            "label": "External broker URL",
            "help": "e.g. mqtt://192.168.1.100:1883 or mqtts://broker:8883",
            "hidden": "!data.useExternalBroker",
            "validator": "!data.useExternalBroker || !!data.externalBrokerUrl",
            "validatorErrorText": "Without URL the built-in MQTT server will be started",
            "validatorNoSaveOnError": false,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "externalBrokerTopics": {
            "newLine": true,
            "type": "text",
            "label": "Topics to subscribe",
            "help": "Comma separated list, e.g. tele/#, stat/#",
            "default": "tele/#, stat/#",
            "hidden": "!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 8,
            "xl": 8
        },
        "externalBrokerUser": {
            "newLine": true,
            "type": "text",
            "label": "External broker user",
            "hidden": "!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "externalBrokerPassword": {
            "type": "password",
            "label": "External broker password",
            "repeat": true,
            "hidden": "!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "bind": {
            "newLine": true,
            "type": "ip",
            "label": "IP",
            "listenOnAllPorts": true,
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "port": {
            "label": "Port",
            "type": "number",
            "min": 1,
            "max": 65535,
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "timeout": {
            "label": "Client timeout",
            "help": "in seconds",
            "type": "number",
            "min": 1,
            "max": 99999,
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_header2": {
            "newLine": true,
            "type": "header",
            "text": "Authentication settings",
            "size": 3,
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "user": {
            "newLine": true,
            "type": "text",
            "label": "User",
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "password": {
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4,
            "type": "password",
            "label": "Password",
            "repeat": true,
            "hidden": "!!data.useExternalBroker"
        },
        "_header3": {
            "newLine": true,
            "type": "header",
            "text": "Auto creation of states",
            "size": 3,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "TELE_SENSOR": {
            "newLine": true,
            "type": "checkbox",
            "label": "For tele/SENSOR",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "TELE_STATE": {
            "type": "checkbox",
            "label": "For tele/STATE",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "TELE_MARGINS": {
            "type": "checkbox",
            "label": "For tele/MARGINS",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "STAT_RESULT": {
            "type": "checkbox",
            "label": "For stat/RESULT",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "OBJ_TREE": {
            "type": "checkbox",
            "label": "Create object tree",
            "help": "WARNING! Check README.md!",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_header4": {
            "newLine": true,
            "type": "header",
            "text": "Other settings",
            "size": 3,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "ignorePings": {
            "newLine": true,
            "type": "checkbox",
            "label": "Ignore warnings with pingreq",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "ignoreNotConnectedWarnings": {
            "type": "checkbox",
            "label": "Ignore 'not connected' warnings",
            "help": "Suppress warnings when commands are sent to offline devices",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "_header5": {
            "newLine": true,
            "type": "header",
            "text": "Advanced MQTT settings",
            "size": 3,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "storeClientsTime": {
            "newLine": true,
            "type": "number",
            "label": "Store clients time",
            "help": "Time in minutes to store client information",
            "min": 1,
            "max": 99999,
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "defaultQoS": {
            "type": "number",
            "label": "Default QoS",
            "help": "Default Quality of Service level (0, 1, or 2)",
            "min": 0,
            "max": 2,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "retransmitInterval": {
            "type": "number",
            "label": "Retransmit interval",
            "help": "Interval in milliseconds for message retransmission",
            "min": 100,
            "max": 99999,
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        },
        "retransmitCount": {
            "type": "number",
            "label": "Retransmit count",
            "help": "Maximum number of retransmission attempts",
            "min": 1,
            "max": 100,
            "hidden": "!!data.useExternalBroker",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 4,
            "xl": 4
        }
    }
}
